{
  "name": "maxiviper117/composer-quarantine",
  "description": "A global Composer plugin that quarantines freshly published package versions until they reach a minimum age.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "composer/composer": "^2.6",
    "composer/metadata-minifier": "^1.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "MaxiViper117\\ComposerQuarantine\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MaxiViper117\\ComposerQuarantine\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/composer-quarantine"
  ],
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  }
}
